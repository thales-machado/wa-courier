# ===========================================
# WA Courier - Environment Configuration
# ===========================================
#
# Copy to .env and adjust (cp .env.example .env). Only WAC_WEB_PASS is required to enable the
# web UI login.

# Web UI login
WAC_WEB_USER=admin
WAC_WEB_PASS=change-me

# API key for programmatic access (X-API-Key header). Sole source of truth: the gateway never
# generates or stores one. Leave unset and the HTTP API stays closed (the web UI still works).
# The UI has a "Generate a key" button if you need a value to paste here.
WAC_API_KEY=

# HTTP port (default 3000)
#PORT=3000

# Log level: trace, debug, info, warn, error (default info)
#LOG_LEVEL=info

# Data directory inside the container (default /app/data)
#DATA_DIR=/app/data

# POSTs a JSON payload here on message delivery status changes
#WAC_STATUS_WEBHOOK_URL=

# Forwards images/documents from allow-listed groups here (multipart/form-data)
#WAC_INBOUND_MEDIA_WEBHOOK_URL=

# Max media size in either direction — B/KB/MB/GB suffixes or plain bytes (default 20MB).
# Applies to inbound downloads and to media fetched from a mediaUrl when sending.
#WAC_MEDIA_MAX_BYTES=20MB

# Signs both webhook deliveries with HMAC-SHA256
#WAC_WEBHOOK_SECRET=

# Comma-separated IPs/CIDRs allowed to reach the gateway at all (applies to every route)
#WAC_ALLOWED_CIDRS=

# Minimum gap between outbound sends, in ms — keeps bursts under WhatsApp's rate limiting
#WAC_SEND_QUEUE_INTERVAL_MS=1500

# Max sends waiting in the queue before new requests get a 503
#WAC_SEND_QUEUE_MAX_PENDING=100

# How long to wait for the queue to drain on shutdown, in ms
#WAC_SHUTDOWN_DRAIN_TIMEOUT_MS=20000
